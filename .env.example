# Copy to .env and fill in. Never commit .env.

# Agent models
MISTRAL_API_KEY=
GEMINI_API_KEY=
# One key for every OpenRouter contestant (cerebro ask --model ...-openrouter)
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Self-hosted models (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Data sources
COMICVINE_API_KEY=

# Tracing (optional)
LANGSMITH_API_KEY=

# Local data folder (gitignored)
DATA_DIR=data
